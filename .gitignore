*.slynor.json

# Research experiment materials (runs, query sets, measurements, reports) stay local
# and are intentionally not published in the repository.
docs/experiment/

# Explicit local storage folders; don't ignore every JSON/SQLite file globally
.local-data/
.local-cache/
.local-backups/
.local-artifacts/
OwnPlayerMusic.zip
# The actual supplied outer archive is also kept outside the repository.
OwnPlayerMusic_2.zip

# Patch delivery manifests describe a package and are kept beside the tree.
PATCH_MANIFEST_*.json
